# Firebase Client (public - get from Firebase Console > Project Settings > General > Your apps > Web)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=phytoflex-gold.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=phytoflex-gold
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=phytoflex-gold.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# Firebase Admin (server-side - get from Firebase Console > Project Settings > Service Accounts > Generate new private key)
# Paste the entire JSON as a single line (escape all quotes)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"phytoflex-gold",...}

# Razorpay (get from https://dashboard.razorpay.com > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
